+#define SOCKET_INTERNAL_FAIL_EXECUTION(fd1, fd2, msg, ...) do { \
+    int err = errno;                                                         \
+    if (msg) builtin_error(msg, __VA_ARGS__);                                \
+    if (fd1 >= 0) close (fd1);                                               \
