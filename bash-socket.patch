+#define FAIL_EXECUTION ACCEPT_FAIL_EXECUTION
 
-static int
-accept_bind_variable (char *varname, int intval)
-{
-  SHELL_VAR *v;
-  char ibuf[INT_STRLEN_BOUND (int) + 1], *p;
-
-  p = fmtulong (intval, 10, ibuf, sizeof (ibuf), 0);
